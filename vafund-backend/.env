# Hyperledger Fabric Configuration
FABRIC_PEER_HOST=peer0.org1.example.com
FABRIC_PEER_PORT=7051
FABRIC_PEER_TLS_NAME=peer0.org1.example.com
FABRIC_ORG_MSP=Org1MSP
FABRIC_CHANNEL=vafundchannel
FABRIC_CHAINCODE=vafundcc

# Crypto Materials Paths
FABRIC_CERT_PATH=./crypto/cert.pem
FABRIC_KEY_PATH=./crypto/key.pem
FABRIC_TLS_CA_PATH=./crypto/tls-ca-cert.pem

# Application Settings
APP_PORT=3000
APP_MODE=production
SIMULATION_MODE=false

# Optional fallback host (only if you run peer external builder)
FABRIC_FALLBACK_HOSTS=localhost:7051
