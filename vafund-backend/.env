# Hyperledger Fabric Configuration
FABRIC_PEER_HOST=127.0.0.1
FABRIC_PEER_PORT=7051
FABRIC_PEER_TLS_NAME=peer0.org1.example.com
FABRIC_ORG_MSP=Org1MSP
FABRIC_CHANNEL=vafundchannel
